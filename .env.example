NODE_ENV=local
PORT=4000

# Host: 127.0.0.1 con `npm run start:dev`. Dentro de Docker Compose (api): DB_HOST=db
DB_HOST=127.0.0.1
# 5433 evita choque si fintrack-api ya ocupa 5432 en Docker
DB_PORT=5433
DB_USERNAME=terminalops-developer
DB_PASSWORD=test1234
DB_DATABASE=terminalops-dev
# En cloud (Railway/etc.): DB_SSL=true
# DB_SSL=false

# CORS del FE (producción: https://app.tudominio.com — varias separadas por coma)
ORIGIN=http://localhost:4200
# URL pública del FE para links de correo (si no, usa el primer ORIGIN)
# APP_URL=https://app.tudominio.com

# Genera secretos nuevos en PRD (≥32 chars, distintos). Nunca uses estos de ejemplo.
JWT_SECRET=2f8c7e1a9b4d4e3f8a6c2b7e5d1f9c3a
JWT_REFRESH_SECRET=2f8c7e1a9b4d4e3f8a6c2b7e5d1u8788
SALT_ROUNDS=10

# Correo transaccional (Resend). Sin RESEND_API_KEY los envíos se omiten (log).
# RESEND_API_KEY=re_xxx
# EMAIL_FROM=TerminalOps <noreply@tudominio.com>

# Alertas 5xx (Slack/Discord incoming webhook). Opcional.
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...

# Swagger: en production queda OFF salvo ENABLE_SWAGGER=true
# ENABLE_SWAGGER=false

# Diesel — FuelPriceService (cache DB 6h; sin keys usa último cache o fallback)
# FUEL_PRICE_CACHE_TTL_HOURS=6
# FUEL_DIESEL_FALLBACK_PRICE_MXN=25.5
# API_NINJAS_KEY=
# OIL_PRICE_API_KEY=
# OIL_PRICE_API_DIESEL_CODE=DIESEL_MX
# DATOS_GOB_MX_FUEL_CSV_URL=

# Object storage — Railway Bucket (Tigris / S3-compatible)
# Required in Railway Variables for document upload/download.
# Use the same names locally and in the API service on Railway:
# RW_URL=https://t3.storageapi.dev
# RW_REGION=auto
# RW_S3_BUCKET=
# RW_ACCESS_KEY_ID=
# RW_SECRET_ACCESS_KEY=
# (Also accepts AWS_S3_BUCKET / AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_ENDPOINT_URL)
